Screen {
    align: center top;
}

#masthead {
    padding: 1 2 0 2;
}

#summary {
    padding: 0 2 1 2;
}

#innings {
    padding: 0 2 1 2;
}

.section {
    padding: 0 2 1 2;
    border-top: heavy $foreground 30%;
}

.section-title {
    text-style: bold;
    padding-bottom: 1;
}

#headlines-section {
    padding: 0 2 1 2;
    border-top: heavy $foreground 30%;
    height: auto;
}

#headlines-title {
    padding-bottom: 1;
}

#headlines-list {
    height: auto;
    max-height: 20;
    background: transparent;
}

#headlines-list > ListItem {
    background: transparent;
    padding: 0 0 1 0;
}

#headlines-list > ListItem.-highlight {
    background: $accent 30%;
}

#body-scroll {
    height: 1fr;
}

#hint-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $panel;
    width: 100%;
}

#picker-title {
    text-style: bold;
    padding: 1 2;
}

#search {
    margin: 0 2 1 2;
}

#picker-body {
    height: 1fr;
}

#help-box {
    align: center middle;
    background: $panel;
    border: heavy $foreground;
    padding: 2 4;
    width: 50;
    height: auto;
}

HelpScreen {
    align: center middle;
}
